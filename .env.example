# =====================================================
# KopaWee Environment Variables — Example
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to source control.
# =====================================================

# 1. DATABASE_URL / DIRECT_URL
# DATABASE_URL: Neon *pooled* connection (host contains "-pooler"), used by the app.
# DIRECT_URL:   Neon *direct* connection (same host without "-pooler"), used only by
#               Prisma Migrate (`prisma migrate deploy`), which needs advisory locks.
# For local development point both at a Neon dev branch, never at production.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# 2. NEXTAUTH_SECRET
# MANDATORY. Used to sign and encrypt NextAuth session cookies and JWTs.
# Generate a strong secret: openssl rand -base64 32
# Value must be a non-empty string — do not leave blank.
# If missing or empty at startup, the application will throw.
NEXTAUTH_SECRET=""

# 3. NEXTAUTH_URL
# The canonical base URL of this deployment (no trailing slash).
# Development: http://localhost:3000
# Production: https://your-domain.com
NEXTAUTH_URL="http://localhost:3000"

# 4. GOOGLE OAUTH 2.0 CREDENTIALS
# Obtain from Google Cloud Console → APIs & Services → Credentials.
# Authorised redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 5. GMAIL SMTP (Nodemailer)
# Required for email verification, password reset, SOS alerts,
# clearance reminders, and logbook approval notifications.
# GMAIL_APP_PASSWORD is a 16-character App Password, not your Gmail password:
# enable 2-Step Verification, then create one at https://myaccount.google.com/apppasswords
# If missing, sendEmail() returns EMAIL_NOT_CONFIGURED and logs a warning.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Resend — kept as a future migration path (needs a verified custom domain)
# RESEND_API_KEY=""
# RESEND_FROM_EMAIL=""

# 6. GEMINI AI API KEY
# Required for the KopaWee AI assistant (/api/ai/listing).
# Obtain from: https://aistudio.google.com/app/apikey
# If missing, the AI endpoint returns AI_NOT_CONFIGURED (503) gracefully.
GEMINI_API_KEY=""


# 7. CRON SECRET
# Protects the /api/cron/journey-status automated status transition endpoint.
# Must match the Authorization header sent by your cron job scheduler.
# Generate: openssl rand -base64 32
CRON_SECRET=""
