// Prisma Schema for KopaWee (NYSC Companion App)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// System application-level roles (access control)
enum ApplicationRole {
  USER
  ADMIN
}

// NYSC lifecycle journey status (separate from application role)
enum NyscStatus {
  PCM
  SERVING
  ALUMNI
}

// Legacy role enum kept for backwards compat with existing RBAC guards
enum Role {
  PCM
  SERVING_CORPER
  CDS_EXEC
  EMPLOYER
  LGA_INSPECTOR
  ALUMNI
}

enum ListingStatus {
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  AVAILABLE
  RESERVED
  SOLD
}

enum LogbookStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SOSStatus {
  ACTIVE
  RESOLVED
}

enum ItemTrackingStatus {
  INTACT
  USED
  MISSING
}

enum StatusChangeType {
  MANUAL
  AUTOMATIC
  ADMIN_REVERSAL
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum DateSource {
  USER_PROVIDED
  ADMIN_VERIFIED
  OFFICIAL_SOURCE
  SYSTEM
}

model User {
  id                String          @id @default(cuid())
  name              String
  email             String          @unique
  passwordHash      String?
  phone             String?
  // Legacy UI role kept for dashboard view switching
  role              Role            @default(PCM)
  // Application access control role
  applicationRole   ApplicationRole @default(USER)
  // NYSC lifecycle journey status
  nyscStatus        NyscStatus      @default(PCM)
  stateOfOrigin     String?
  deployedState     String?
  lga               String?
  ppaName           String?
  callUpNo          String?
  stateCode         String?         @unique
  avatarUrl         String?
  isVerified        Boolean         @default(false)
  verificationToken String?
  passwordResetToken  String?   @unique
  passwordResetExpiry DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Relationships
  checklist           CampChecklist?
  packingItems        PackingItem[]
  accommodations      AccommodationListing[]
  marketplaceItems    MarketplaceItem[]
  logbookEntries      PPALogbookEntry[]      @relation("CorperLogbooks")
  approvedLogbooks    PPALogbookEntry[]      @relation("EmployerApprovals")
  sosAlerts           SOSAlert[]
  roommateRequests    RoommateRequest[]
  roommateInterests   RoommateInterest[]   @relation("UserRoommateInterests")
  monthlyClearances   MonthlyClearance[]
  statusHistory       UserStatusHistory[]    @relation("StatusHistoryUser")
  adminStatusChanges  UserStatusHistory[]    @relation("StatusHistoryAdmin")
  nyscJourney         NYSCJourney?
  notifications       Notification[]
  subscription        UserSubscription?

  @@index([role])
  @@index([deployedState])
  @@index([nyscStatus])
  @@index([applicationRole])
}

// ─────────────────────────────────────────────────────────────────────────────
// NYSC JOURNEY (Progressive profiling: camp dates & service dates)
// ─────────────────────────────────────────────────────────────────────────────
model NYSCJourney {
  id                    String     @id @default(cuid())
  userId                String     @unique
  user                  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  // PCM phase dates
  campEntryDate         DateTime?
  campExitDate          DateTime?
  campDateSource        DateSource @default(USER_PROVIDED)
  // Serving phase dates
  serviceStartDate      DateTime?
  serviceEndDate        DateTime?
  serviceDateSource     DateSource @default(USER_PROVIDED)
  // Additional NYSC info
  batch                 String?
  stream                String?
  institution           String?
  courseOfStudy         String?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// MONTHLY CLEARANCE
// ─────────────────────────────────────────────────────────────────────────────
model MonthlyClearance {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  completedAt     DateTime @default(now())
  nextEligibleAt  DateTime
  notes           String?

  @@index([userId])
  @@index([userId, nextEligibleAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// PACKING ITEMS (rich per-item tracking replacing simple JSON CampChecklist)
// ─────────────────────────────────────────────────────────────────────────────
model PackingItem {
  id                    String             @id @default(cuid())
  userId                String
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                  String
  category              String             @default("general")
  isCustom              Boolean            @default(false)
  // PCM phase
  pcmCompleted          Boolean            @default(false)
  // Serving phase stock tracking
  servingTrackingStatus ItemTrackingStatus @default(INTACT)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([userId])
  @@index([userId, category])
}

// Legacy CampChecklist (kept for backwards compatibility during migration)
model CampChecklist {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  completedItems Json     @default("[]")
  updatedAt      DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// USER STATUS HISTORY (Audit trail for all NYSC status transitions)
// ─────────────────────────────────────────────────────────────────────────────
model UserStatusHistory {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation("StatusHistoryUser", fields: [userId], references: [id], onDelete: Cascade)
  previousStatus NyscStatus
  newStatus      NyscStatus
  changedBy      String
  changedByUser  User?            @relation("StatusHistoryAdmin", fields: [changedBy], references: [id])
  changeType     StatusChangeType
  reason         String?
  createdAt      DateTime         @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────────────────────────────────────
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

// ─────────────────────────────────────────────────────────────────────────────
// SUBSCRIPTION PLANS & USER SUBSCRIPTIONS
// ─────────────────────────────────────────────────────────────────────────────
model SubscriptionPlan {
  id            String             @id @default(cuid())
  name          String             @unique
  slug          String             @unique
  description   String
  price         Float              @default(0)
  isActive      Boolean            @default(true)
  isEarlyAccess Boolean            @default(false)
  features      Json               @default("[]")
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  subscriptions UserSubscription[]

  @@index([slug])
}

model UserSubscription {
  id        String             @id @default(cuid())
  userId    String             @unique
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId    String
  plan      SubscriptionPlan   @relation(fields: [planId], references: [id])
  status    SubscriptionStatus @default(ACTIVE)
  startsAt  DateTime           @default(now())
  endsAt    DateTime?

  @@index([userId])
  @@index([planId])
}

// ─────────────────────────────────────────────────────────────────────────────
// EXISTING MODELS (unchanged)
// ─────────────────────────────────────────────────────────────────────────────
enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum RoommateRequestStatus {
  ACTIVE
  CANCELLED
  MATCHED
}

model State {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  lgas      LGA[]
  createdAt DateTime @default(now())

  @@index([name])
}

model LGA {
  id        String   @id @default(cuid())
  name      String
  stateId   String
  state     State    @relation(fields: [stateId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([stateId, name])
  @@index([stateId])
}

model RoommateRequest {
  id                 String                @id @default(cuid())
  userId             String
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  state              String
  lga                String
  area               String?
  budget             String
  accommodationType  String
  moveInDate         String?
  preferences        String?
  status             RoommateRequestStatus @default(ACTIVE)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  interests          RoommateInterest[]

  @@index([userId, status])
  @@index([state, lga])
}

enum RoommateInterestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model RoommateInterest {
  id               String                 @id @default(cuid())
  requestId        String
  interestedUserId String
  status           RoommateInterestStatus @default(PENDING)
  message          String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  request        RoommateRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  interestedUser User            @relation("UserRoommateInterests", fields: [interestedUserId], references: [id], onDelete: Cascade)

  @@unique([requestId, interestedUserId])
  @@index([requestId])
  @@index([interestedUserId])
}

model AccommodationListing {
  id                 String             @id @default(cuid())
  title              String
  description        String
  location           String
  state              String
  lga                String
  price              String
  splitInfo          String?
  contactPhone       String
  images             String[]
  status             ListingStatus      @default(AVAILABLE)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  ownerId            String
  owner              User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([state, lga])
}

model MarketplaceItem {
  id          String        @id @default(cuid())
  title       String
  category    String
  price       String
  description String
  state       String
  lga         String
  images      String[]
  status      ListingStatus @default(AVAILABLE)
  sellerId    String
  seller      User          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([state, category])
}

model PPALogbookEntry {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation("CorperLogbooks", fields: [userId], references: [id], onDelete: Cascade)
  date        String
  summary     String
  hoursWorked Int           @default(8)
  status      LogbookStatus @default(PENDING)
  employerId  String?
  employer    User?         @relation("EmployerApprovals", fields: [employerId], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId, date])
}

model CDSEvent {
  id          String   @id @default(cuid())
  title       String
  cdsGroup    String
  state       String
  lga         String
  date        String
  location    String
  description String
  attendees   Json     @default("[]")
  createdAt   DateTime @default(now())

  @@index([cdsGroup, state])
}

model SOSAlert {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  latitude    Float
  longitude   Float
  state       String
  lga         String
  message     String
  status      SOSStatus @default(ACTIVE)
  createdAt   DateTime  @default(now())

  @@index([state, status])
}

model FormOption {
  id        String   @id @default(cuid())
  category  String   // e.g. "field_of_study", "nysc_camp", "ppa_type"
  value     String
  label     String
  createdAt DateTime @default(now())

  @@unique([category, value])
  @@index([category])
}

model AdminInvite {
  id        String          @id @default(cuid())
  email     String          @unique
  token     String          @unique
  role      ApplicationRole @default(USER)
  invitedBy String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime        @default(now())

  @@index([token])
  @@index([email])
}
